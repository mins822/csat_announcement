                    android:startY="155.5"
                    android:endX="181.5"
                    android:endY="161.5"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#613A0828"/>
                    <item android:offset="0.32" android:color="#2E3A0828"/>
                    <item android:offset="0.68" android:color="#0A3A0828"/>
                    <item android:offset="1.0" android:color="#003A0828"/>
