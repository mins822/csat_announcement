                    <item android:offset="0.28" android:color="#3D3A0828"/>
                    <item android:offset="0.62" android:color="#123A0828"/>
                    <item android:offset="1.0" android:color="#003A0828"/>
                </gradient>
            </aapt:attr>
        </path>
        <!-- 시침 중심쪽 둥근 캡(x=173.5) 내부 음영 -->
        <path android:pathData="M185.5,147.5 L224.5,147.5 A12.5,12.5 0 0,1 237,160 A12.5,12.5 0 0,1 224.5,172.5 L185.5,172.5 A12.5,12.5 0 0,1 173,160 A12.5,12.5 0 0,1 185.5,147.5 Z">
            <aapt:attr name="android:fillColor">
