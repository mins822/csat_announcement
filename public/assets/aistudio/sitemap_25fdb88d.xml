<?xml version="1.0" encoding="UTF-8"?>
<!--
  2027학년도 대학수학능력시험 시험장 안내방송 구현 (mins822)
  배치 위치: Vite 프로젝트의 public/sitemap.xml
  → 빌드 시 https://mins822.github.io/csat_announcement/sitemap.xml 로 배포됨
  주의: 이 파일에는 /csat_announcement/ 하위 주소만 넣을 수 있음 (다른 경로는 무시됨)
  주소는 canonical 태그와 글자 하나까지 똑같이(끝의 / 포함) 맞출 것
  lastmod는 실제로 내용을 수정했을 때만 갱신 (W3C 날짜 형식: YYYY-MM-DD)
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- 1) 메인 앱: 안내방송 · 타종 · 시계 · 백색소음 -->
  <url>
    <loc>https://mins822.github.io/csat_announcement/</loc>
    <lastmod>2026-11-26</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="ko" href="https://mins822.github.io/csat_announcement/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://mins822.github.io/csat_announcement/"/>
    <image:image>
      <image:loc>https://mins822.github.io/csat_announcement/og-image.jpg</image:loc>
    </image:image>
  </url>

  <!-- 2) 독립 실행 HTML 버전: 오프라인 저장·공유용 단일 파일 타종 타이머 -->
  <url>
    <loc>https://mins822.github.io/csat_announcement/csat-timer-standalone.html</loc>
    <lastmod>2026-11-26</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ko" href="https://mins822.github.io/csat_announcement/csat-timer-standalone.html"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://mins822.github.io/csat_announcement/csat-timer-standalone.html"/>
  </url>

  <!--
    아래는 페이지를 따로 만들었을 때 주석을 풀어서 추가하는 예시
    (해시 라우팅 #/... 주소는 색인되지 않으므로 넣지 말 것)

  <url>
    <loc>https://mins822.github.io/csat_announcement/schedule/</loc>
    <lastmod>2026-11-26</lastmod>
    <priority>0.7</priority>
  </url>
  -->

</urlset>
